# Copy this file to keystore.properties (which git ignores) to sign release builds on this computer.
# CI reads the same values from the environment: KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD.
# Without them the release build is not signed (fine for a check of R8, useless for Google Play).

# The key store of ChurkinApps holds one key per app; Truck Remote's alias is "Truck Remote Control" (with the spaces).
# The store has its own (master) password and every key its own password. The path may be absolute; keep the file out of the repository.
storeFile=C:/Projects/churkinapps_keystore.jks
storePassword=…
keyAlias=Truck Remote Control
keyPassword=…
