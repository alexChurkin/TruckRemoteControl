<?xml version="1.0" encoding="utf-8"?>
<com.alexchurkin.truckremote.ui.widget.WithInsetsConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundMain"
    android:keepScreenOn="true"
    android:orientation="horizontal">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/breakLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/backgroundpress"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/connectionIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:padding="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/connection_indicator_red" />

            <com.alexchurkin.truckremote.ui.widget.PedalImageView
                android:id="@+id/breakImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="60dp"
                android:layout_marginBottom="37dp"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="@drawable/pedal_break" />

            <!-- Press force of an analog pedal, over the pedal -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/breakLevelLabel"
                style="@style/PedalLevelLabel"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@id/breakImage"
                app:layout_constraintEnd_toEndOf="@id/breakImage"
                app:layout_constraintStart_toStartOf="@id/breakImage" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/gasLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/backgroundpress"
            android:clickable="true"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/pauseButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/pause_btn_resumed" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/settingsButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:background="?selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:scaleType="fitCenter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/pauseButton"
                app:layout_constraintTop_toBottomOf="@+id/pauseButton"
                app:srcCompat="@drawable/ic_settings" />

            <com.alexchurkin.truckremote.ui.widget.PedalImageView
                android:id="@+id/gasImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="60dp"
                android:layout_marginBottom="41dp"
                android:adjustViewBounds="true"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:srcCompat="@drawable/pedal_gas" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/gasLevelLabel"
                style="@style/PedalLevelLabel"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toTopOf="@id/gasImage"
                app:layout_constraintEnd_toEndOf="@id/gasImage"
                app:layout_constraintStart_toStartOf="@id/gasImage" />

            <!-- Appears beside the press force when the gas is locked: the force moves aside for it -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/gasLockIcon"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:text="@string/gas_lock_icon"
                android:textSize="18sp"
                app:layout_constraintBaseline_toBaselineOf="@id/gasLevelLabel"
                app:layout_constraintEnd_toStartOf="@id/gasLevelLabel" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/buttonAllSignals"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="@null"
        android:paddingTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/dashboardView"
        app:srcCompat="@drawable/emergency_off" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/buttonLeftSignal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:background="@null"
        android:paddingStart="6dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        app:layout_constraintRight_toLeftOf="@+id/buttonAllSignals"
        app:layout_constraintTop_toTopOf="@id/buttonAllSignals"
        app:srcCompat="@drawable/left_disabled" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/buttonRightSignal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@null"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="6dp"
        app:layout_constraintStart_toEndOf="@+id/buttonAllSignals"
        app:layout_constraintTop_toTopOf="@id/buttonAllSignals"
        app:srcCompat="@drawable/right_disabled" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/buttonHorn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="24dp"
        android:background="?selectableItemBackgroundBorderless"
        app:layout_constraintRight_toLeftOf="@id/buttonParking"
        app:layout_constraintTop_toBottomOf="@+id/buttonRightSignal"
        app:srcCompat="@drawable/horn" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/buttonParking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@null"
        android:paddingBottom="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonAllSignals"
        app:srcCompat="@drawable/parking_break_off" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/buttonLights"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="10dp"
        android:background="?selectableItemBackgroundBorderless"
        app:layout_constraintLeft_toRightOf="@id/buttonParking"
        app:layout_constraintTop_toBottomOf="@+id/buttonRightSignal"
        app:srcCompat="@drawable/lights_off" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/actionsButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="?selectableItemBackgroundBorderless"
        android:contentDescription="@string/actions"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_actions" />

    <!-- Instruments of the truck (DashboardSlot) at the top. Without them the view has no height; when they
         slide in, the blinkers and the controls under them are pushed down -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/dashboardView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- The cruise control (CruiseSlot) under the middle controls, shown with the instruments -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/cruiseView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/buttonParking" />

    <!-- Pages of quick actions (ActionsPanel) -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/actionsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/actionsButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Short messages (connection, auto pause): a system toast keeps away from the display cutout,
         so it isn't in the middle of the screen -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/messageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:accessibilityLiveRegion="polite"
        android:alpha="0"
        android:background="@drawable/message_background"
        android:elevation="6dp"
        android:gravity="center"
        android:maxWidth="420dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@color/m3_onSurface"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/actionsButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</com.alexchurkin.truckremote.ui.widget.WithInsetsConstraintLayout>